# Variabili d'ambiente — esempio, nessun valore reale.
# Copiare in .env.local (ignorato da Git) e compilare.

# --- Frontend (Vite): valori pubblici, finiscono nel bundle ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Solo lato server/CI: mai nel frontend, mai in Git ---
# SUPABASE_SECRET_KEY=
# SUPABASE_JWT_SECRET=

# --- Keepalive (workflow GitHub Actions e Raspberry Pi) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
