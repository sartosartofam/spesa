# Variabili d'ambiente — esempio, nessun valore reale.
# Copiare in .env.local (ignorato da Git) solo per un progetto cloud.

# --- Frontend (Vite): valori pubblici, finiscono nel bundle ---
# In locale NON compilare a mano: dopo `npm run db:start` esegui `npm run env:local`.
# Lo script legge `supabase status` e scrive .env.local con URL e anon key locali.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# --- Solo lato server/CI: mai nel frontend, mai in Git ---
# SUPABASE_SECRET_KEY=
# SUPABASE_JWT_SECRET=

# --- Keepalive (workflow GitHub Actions e Raspberry Pi) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
